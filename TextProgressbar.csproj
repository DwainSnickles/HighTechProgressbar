<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Dwain.TextProgressbar</PackageId>
    <Title>TextProgressbar for .NET 10</Title>
    <Authors>Dwain Snickles</Authors>
    <Description>Custom WinForms ProgressBar control with three-color gradient rendering, configurable border and aligned text overlay. Based on taancer/HighTechProgressBar (https://github.com/taancer/HighTechProgressBar).</Description>
    <PackageTags>winforms;progressbar;custom-controls;controls;dotnet;net10;windows-forms;csharp;gui</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DwainSnickles/TextProgressbar</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DwainSnickles/TextProgressbar.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Rounded corners and pill-style segmented blocks (BlockCornerRadius, CornerRadius), circular ring mode with RingThickness/StartAngle/RoundCaps, vertical orientation, five RenderStyle modes (Gradient, Blocks3D, Segmented, Neon, Striped), shimmer sweep effect, and per-block gradient direction.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="TextProgressbar.Samples\**\*.cs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
